# ============================================================================
# Réglages de la console. Copiez ce fichier en « .env » puis remplissez-le :
#     cp .env.exemple .env && nano .env
# ⚠ Le fichier .env contient un SECRET : ne l'envoyez jamais sur GitHub,
#   ne le partagez pas, et limitez ses droits : chmod 600 .env
# ============================================================================

# Adresse où la console sera accessible (le nom doit pointer vers CE serveur, voir le guide).
CONSOLE_DOMAINE=console.mmbt.fr

# --- Mise en ligne automatique vers le site public (via GitHub) ---
# Dépôt qui contient le site relié à OVH.
GITHUB_REPO=Kalmache/natidja
# Branche surveillée par OVH.
GITHUB_BRANCHE=main
# Jeton d'accès GitHub « fine-grained » : UNIQUEMENT ce dépôt, UNIQUEMENT la permission
# « Contents : Read and write ». Voir docs/DEPLOIEMENT-CONSOLE.md, étape 5.
GITHUB_TOKEN_PUBLICATION=

# --- Service d'attestation (facultatif : protection réelle de la moyenne et de la date de naissance) ---
# Adresse du site public (seule autorisée à interroger le service) :
SITE_PUBLIC_URL=
# Nom de domaine du service (ex. attestation.mmbt.fr) :
ATTESTATION_DOMAINE=
