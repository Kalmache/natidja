# Caddy : serveur web qui obtient et renouvelle SEUL le certificat HTTPS (Let's Encrypt).
# Le nom de domaine vient du fichier .env (CONSOLE_DOMAINE, ex. console.mmbt.fr).
{$CONSOLE_DOMAINE} {
	encode zstd gzip

	# Tout passe par ici ; la console n'est joignable que par ce biais.
	reverse_proxy console:8787

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}
}

# Service d'attestation (FACULTATIF). Si vous ne l'utilisez pas, supprimez ce bloc entier
# (sinon Caddy essaie d'obtenir un certificat pour un nom qui n'existe pas et le note dans ses journaux).
{$ATTESTATION_DOMAINE} {
	encode zstd gzip
	reverse_proxy attestation:8790
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}
}
